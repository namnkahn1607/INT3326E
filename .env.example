# ========================================================
# ParcelFlow - Global Environment Configuration Template
# ========================================================

# Environment
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://parcelflow:parcelflow@localhost:5432/parcelflow?schema=public"
POSTGRES_USER=parcelflow
POSTGRES_PASSWORD=parcelflow
POSTGRES_DB=parcelflow
POSTGRES_PORT=5432

# Google Cloud Pub/Sub / Local Emulator
GCP_PROJECT_ID=int3326e
PUBSUB_PROJECT_ID=int3326e
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_TOPIC_GPS_EVENTS=gps-events
PUBSUB_SUB_GPS_EVENTS=gps-events-sub
PUBSUB_SUBSCRIPTION=gps-events-sub

# Backend API (NestJS - apps/api)
API_PORT=3000
API_GLOBAL_PREFIX=v1

# GPS Worker (Cloud Run Consumer - apps/worker)
WORKER_PORT=3001

# Web Frontend (Vite + React - apps/web)
VITE_API_URL=http://localhost:3000/v1
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=int3326e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=int3326e
