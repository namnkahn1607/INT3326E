{
  "openapi": "3.0.3",
  "info": {
    "title": "ParcelFlow Core Logistics API (MVP)",
    "description": "Week 1 draft for later ParcelFlow API implementation. Only GET /healthz is implemented in the scaffold. Business operations are proposals, not live endpoints.\n\nRoles: CUSTOMER, DRIVER, ADMIN; Admin performs dispatch operations.\nBaseline shipment flow: CREATED -> ASSIGNED -> PICKED_UP -> DELIVERED / DELIVERY_FAILED.\nDraft conventions: business routes use /v1; GPS POST /locations returns 202; REST uses dropoffAddress/dropoffLocation and data/pagination. See docs/api-contract.md for field mappings and pending integration decisions. Cancellation is preserved separately under x-proposals and requires team approval. Session/sequence GPS behavior, identifier design and idempotency require review before implementation.",
    "version": "0.2.0-week1-draft"
  },
  "servers": [
    {
      "url": "http://localhost:3000/v1",
      "description": "Local business API draft; use TV5's verified URL for Cloud Run"
    }
  ],
  "tags": [
    {
      "name": "Shipments",
      "description": "Shipment lifecycle creation, inspection, and state machine transitions."
    },
    {
      "name": "Tracking & Location",
      "description": "Async driver telemetry ingestion and consolidated tracking + ETA read-path."
    },
    {
      "name": "Health",
      "description": "Week 1 public liveness"
    }
  ],
  "paths": {
    "/shipments": {
      "post": {
        "tags": [
          "Shipments"
        ],
        "summary": "Create a new shipment (Customer only)",
        "description": "Creates a shipment in `CREATED` status. Requires `CUSTOMER` role.\n\nClients MUST provide an `Idempotency-Key` header to safely retry on transient network failures without creating duplicate orders.",
        "operationId": "createShipment",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKeyRequired"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Shipment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/409Conflict"
          },
          "429": {
            "$ref": "#/components/responses/429TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/500InternalServerError"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-implementation-status": "draft"
      },
      "get": {
        "tags": [
          "Shipments"
        ],
        "summary": "List shipments with keyset pagination",
        "description": "Retrieves a paginated list of shipments ordered by `createdAt DESC, id DESC`. Scope is filtered by caller role:\n- `CUSTOMER`: Only shipments created by caller\n- `DRIVER`: Only shipments assigned to caller\n- `ADMIN`: All system shipments",
        "operationId": "listShipments",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor encoding the `(createdAt, id)` tuple of the last record for keyset pagination.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of items to retrieve (default: 20, max: 100).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter shipments by lifecycle status.",
            "schema": {
              "$ref": "#/components/schemas/ShipmentStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated shipment records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedShipmentsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/429TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/500InternalServerError"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-implementation-status": "draft"
      }
    },
