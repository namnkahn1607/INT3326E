API_PORT=3000
FIREBASE_PROJECT_ID=int3326e
# Cloud Run supplies PORT; it takes precedence over API_PORT.
# Real token verification uses ADC/runtime service account credentials outside the repository.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://int3326e.web.app
# Local auth emulator only, with FIREBASE_PROJECT_ID=demo-parcelflow:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Never set the emulator host in production.

# Required for business user linkage, Admin reads and shipment Create; use runtime secrets.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Create replay window, default 24h; integer seconds in 1..31536000. No startup migration.
SHIPMENT_IDEMPOTENCY_TTL_SECONDS=86400
# Services key for geocoding; server only, never a VITE_* variable or Tilemap key.
VIETMAP_API_KEY=
