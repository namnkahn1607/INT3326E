{
  "name": "parcelflow",
  "version": "0.1.0",
  "private": true,
  "description": "ParcelFlow - Modular Monolith logistics & delivery platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@parcelflow/web",
    "build:web": "npm run build --workspace=@parcelflow/web",
    "lint:web": "npm run lint --workspace=@parcelflow/web",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
